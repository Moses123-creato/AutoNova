# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows Zone.Identifier sidecar artifacts
*.Zone.Identifier
*Zone.Identifier

# local third-party reference export (not part of the app)
/huly

# browser/MCP tooling artifacts
/.playwright-mcp

# local notes that contain credentials
/Stitch Connection.md
